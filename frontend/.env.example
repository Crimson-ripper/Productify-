# Frontend environment variables — copy to frontend/.env and fill in

# The public URL of your deployed backend. In dev, this is your local FastAPI server.
# NO trailing slash. All API calls prefix "/api" onto this value.
REACT_APP_BACKEND_URL=http://localhost:8001

# Dev-server HMR socket port. In production behind HTTPS, set to 443.
WDS_SOCKET_PORT=443
