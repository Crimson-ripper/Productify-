# Backend environment variables — copy to backend/.env and fill in

# --- Core ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="productify"
JWT_SECRET="replace-with-a-long-random-string-openssl-rand-hex-48"
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# --- Seed admin (created on first backend start if the email doesn't exist) ---
ADMIN_EMAIL="admin@productifynow.com"
ADMIN_PASSWORD="ChangeThisNow-123!"

# --- Emergent Object Storage (get from Emergent dashboard → Universal Key) ---
EMERGENT_LLM_KEY="sk-emergent-XXXXXXXXXXXX"
INTEGRATION_PROXY_URL="https://integrations.emergentagent.com"
APP_NAME="productify"

# --- Payments (optional; leave blank to keep mocked checkout) ---
# STRIPE_API_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""

# --- Twilio (optional; for future seller phone OTP) ---
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
